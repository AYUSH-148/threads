# ---- Database ----
# Transactions require a replica set. Atlas (including the free M0 tier) is one;
# a plain local `mongod` is not — use docker-compose.yml, which starts a
# single-node replica set for exactly this reason.
MONGODB_URL=

# ---- Redis ----
# Carries the event stream, the pub/sub channel behind SSE, and the relay lock.
# Upstash: rediss://default:<password>@<host>:<port>
# Local:   redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- API service (server/) ----
# The Express service: SSE, the notification endpoints, health and metrics. Read
# by the service itself.
PORT=4000
# Browser origins allowed to call it. Comma-separated, no trailing slash. Also
# the `authorizedParties` the Clerk token must have been issued for.
APP_ORIGIN=http://localhost:3000

# Where the browser finds that service. Read by Next at build time, so it is
# public — which is fine, it is a hostname and every endpoint authenticates.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Clerk ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Optional. Clerk's PEM public key ("JWKS public key" in the dashboard, under
# API keys → Show JWT public key). Supplying it makes the API service's token
# verification fully networkless: no outbound call per request, and
# authentication keeps working while Clerk's API is unreachable. Without it the
# service fetches the JWKS once and caches it.
CLERK_JWT_KEY=

# ---- UploadThing ----
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
