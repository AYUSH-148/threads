# ---- Database ----
# Transactions require a replica set. Atlas (including the free M0 tier) is one;
# a plain local `mongod` is not — use docker-compose.yml, which starts a
# single-node replica set for exactly this reason.
MONGODB_URL=

# ---- Redis ----
# Carries the event stream, the pub/sub channel behind SSE, and the relay lock.
# Upstash: rediss://default:<password>@<host>:<port>
# Local:   redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ---- Clerk ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ---- UploadThing ----
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
