{
  "compilerOptions": {
    // Set explicitly because it was not: with no target, `tsc --noEmit` checks
    // the whole repo against ES5 semantics, which rejects ordinary things like
    // iterating a Set. Next transpiles with SWC and browserslist rather than
    // this setting, and the API service and worker run on Node 20 — so nothing
    // here needs to pretend to be ES5.
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
